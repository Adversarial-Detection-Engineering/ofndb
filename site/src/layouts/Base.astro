---
import '../styles/global.css';
import { siteData } from '../lib/load';
import { SITE_NAME, href } from '../lib/util';

const { stats } = siteData();

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'OriginalFilename values for LOLBins, Windows binaries and common tools, parsed from the PE and checked against Sysmon.',
} = Astro.props;

const nav = [
  ['', 'Library'],
  ['gotchas/', 'Gotchas'],
  ['lookups/', 'Lookups'],
  ['about/', 'About'],
];
const REPO_URL = 'https://github.com/Adversarial-Detection-Engineering/ofndb';
const current = Astro.url.pathname;
const isCurrent = (path: string) => (path === '' ? current === href('') : current.startsWith(href(path)));
const canonical = new URL(current, Astro.site).href;
const fullTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(href('og.png'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={href('')}><span class="brand-mark">OFN</span><span class="brand-rest">db</span></a>
        <nav aria-label="Main">
          {nav.map(([path, label]) => <a href={href(path)} aria-current={isCurrent(path) ? 'page' : undefined}>{label}</a>)}
          <a class="gh" href={REPO_URL} aria-label="GitHub repository" title="GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          {stats.updated && <>Data updated {stats.updated} · </>}{stats.entries.toLocaleString('en-US')} binaries ·
          {stats.builds.toLocaleString('en-US')} parsed builds · {stats.verified_entries.toLocaleString('en-US')} confirmed
          against Sysmon {stats.sysmon_versions.join(', ')}
        </p>
        <p class="muted">
          Values are parsed from each PE's own version resource and checked against live Sysmon events. Built on LOLBAS,
          LOLRMM, Winbindex, SigmaHQ and Sysinternals.
        </p>
      </div>
    </footer>
    <script is:inline>
      document.addEventListener('click', async (ev) => {
        const btn = ev.target.closest('[data-copy]');
        if (btn) {
          btn.dataset.label ??= btn.textContent;
          const reset = () => { btn.textContent = btn.dataset.label; btn.classList.remove('done'); };
          // an empty data-copy means: copy the code block next to the button
          const text = btn.dataset.copy || btn.closest('.code')?.querySelector('pre')?.textContent || '';
          try {
            await navigator.clipboard.writeText(text);
            btn.textContent = 'Copied';
            btn.classList.add('done');
          } catch { btn.textContent = 'Copy failed'; }
          setTimeout(reset, 1200);
          return;
        }
        const tab = ev.target.closest('[role="tab"]');
        if (tab) {
          const box = tab.closest('[data-tabs]');
          box.querySelectorAll('[role="tab"]').forEach((t) => {
            t.setAttribute('aria-selected', String(t === tab));
            t.tabIndex = t === tab ? 0 : -1;
          });
          box.querySelectorAll('[data-panel]').forEach((p) => { p.hidden = p.dataset.panel !== tab.dataset.tab; });
          try { localStorage.setItem('ofn-platform', tab.dataset.tab); } catch {}
        }
      });
      // tablist keyboard contract: arrows move and select, Home/End jump
      document.addEventListener('keydown', (ev) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(ev.key)) return;
        const tab = ev.target.closest?.('[role="tab"]');
        if (!tab) return;
        const tabs = [...tab.closest('[role="tablist"]').querySelectorAll('[role="tab"]')];
        const i = tabs.indexOf(tab);
        const next =
          ev.key === 'ArrowRight' ? tabs[(i + 1) % tabs.length]
          : ev.key === 'ArrowLeft' ? tabs[(i - 1 + tabs.length) % tabs.length]
          : ev.key === 'Home' ? tabs[0]
          : tabs[tabs.length - 1];
        ev.preventDefault();
        next.click();
        next.focus();
      });
      try {
        const saved = localStorage.getItem('ofn-platform');
        if (saved) document.querySelectorAll(`[role="tab"][data-tab="${saved}"]`).forEach((t) => t.click());
      } catch {}
    </script>
  </body>
</html>
