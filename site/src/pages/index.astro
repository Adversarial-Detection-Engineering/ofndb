---
import Base from '../layouts/Base.astro';
import type { Entry } from '../lib/derive';
import { siteData } from '../lib/load';
import { CATEGORY_LABELS, SITE_NAME, href, wbr } from '../lib/util';

const { entries, stats } = siteData();
const cats = Object.keys(CATEGORY_LABELS).filter((c) => stats.categories[c]);
const quickFlags = [
  ['drift', 'Changed across builds'],
  ['no-ofn', 'No OriginalFilename'],
  ['differs-from-name', 'Differs from file name'],
  ['dll-ofn', 'Names a DLL'],
];
const searchText = (e: Entry) =>
  [e.name, ...e.distinct_values, e.description ?? '', e.company ?? '', ...e.internal_names, e.notes ?? '', ...e.gotchas.map((g) => g.text.replace(/`/g, ''))]
    .join(' ')
    .toLowerCase();

// schema.org Dataset markup so the data surfaces in Google Dataset Search
const abs = (path: string) => new URL(href(path), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'ofndb — OriginalFilename database',
  description:
    `The OriginalFileName of ${stats.entries} LOLBins, Windows binaries and admin tools as Sysmon and EDR sensors log it, ` +
    `parsed from the PE version resource across ${stats.builds} builds and checked against live Sysmon events.`,
  url: abs(''),
  license: 'https://creativecommons.org/licenses/by/4.0/',
  isAccessibleForFree: true,
  keywords: ['OriginalFileName', 'LOLBin', 'detection engineering', 'Sysmon', 'EDR', 'PE version resource', 'rename detection'],
  ...(stats.updated && { dateModified: stats.updated }),
  distribution: [
    ['exports/ofn.csv', 'text/csv'],
    ['exports/ofn.json', 'application/json'],
    ['exports/ofn_pairs.csv', 'text/csv'],
    ['exports/ofn_pairs.kql', 'text/plain'],
  ].map(([path, format]) => ({ '@type': 'DataDownload', contentUrl: abs(path), encodingFormat: format })),
};
---

<Base title={SITE_NAME}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="hero">
    <h1>OriginalFilename, as sensors log it</h1>
    <p class="lede">
      The <code>OriginalFileName</code> value for {stats.entries.toLocaleString('en-US')} LOLBins, Windows binaries and admin
      tools. Parsed from the PE itself across {stats.builds.toLocaleString('en-US')} builds,
      then checked against real Sysmon events. Not the <code>.MUI</code> value Explorer shows you.
    </p>
  </section>

  <section class="finder" aria-label="Find a binary">
    <div class="search-row">
      <input
        id="q"
        type="search"
        placeholder="Search: pwsh, nltest, psexec.c, Process Monitor…"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search binaries and OriginalFilename values"
      />
      <span id="count" class="count" aria-live="polite">{entries.length} binaries</span>
    </div>
    <div class="filter-group">
      <span class="filter-label" id="lbl-cat">Categories</span>
      <div class="chips" role="group" aria-labelledby="lbl-cat">
        <button class="chip" aria-pressed="true" data-cat="">All <span>{stats.entries}</span></button>
        {cats.map((c) => <button class="chip" aria-pressed="false" data-cat={c}>{CATEGORY_LABELS[c]} <span>{stats.categories[c]}</span></button>)}
      </div>
    </div>
    <div class="filter-group">
      <span class="filter-label" id="lbl-prop">Properties</span>
      <div class="chips flags" role="group" aria-labelledby="lbl-prop">
        {quickFlags.map(([f, label]) => <button class="chip chip-flag" aria-pressed="false" data-flag={f}>{label} <span>{stats.flags[f] ?? 0}</span></button>)}
        <button class="chip chip-flag" aria-pressed="false" data-verified>Sysmon-confirmed <span>{stats.verified_entries}</span></button>
      </div>
    </div>
  </section>

  <div class="table-wrap lib-wrap">
    <table class="lib" id="lib">
      <thead>
        <tr><th>Binary</th><th>OriginalFilename</th><th class="hide-sm">Category</th><th title="Confirmed against a live Sysmon event">Sysmon</th></tr>
      </thead>
      <tbody>
        {
          entries.map((e) => (
            <tr data-s={searchText(e)} data-cat={e.categories.join(' ')} data-flags={e.flags.join(' ')} data-v={e.verified ? '1' : '0'}>
              <td><a href={href(`b/${e.slug}/`)} set:html={wbr(e.name)} /></td>
              <td class="mono">
                {e.primary ? <Fragment set:html={wbr(e.primary)} /> : <span class="none">none</span>}
                {e.distinct_values.length > 1 && <span class="more" title={e.distinct_values.join(', ')}>+{e.distinct_values.length - 1}</span>}
              </td>
              <td class="hide-sm"><span class={`cat cat-${e.category}`}>{CATEGORY_LABELS[e.category]}</span></td>
              <td class="ok">{e.verified ? <span title="Confirmed against Sysmon">✓</span> : ''}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p id="empty" class="empty" hidden>No match. Try part of a name or value, or clear the filters.</p>
  </div>

  <script is:inline>
    (() => {
      const q = document.getElementById('q');
      const rows = [...document.querySelectorAll('#lib tbody tr')];
      const count = document.getElementById('count');
      const empty = document.getElementById('empty');
      let cat = '';
      const flags = new Set();
      let verified = false;

      // dataset parsing hoisted out of the filter loop: it reruns on every keystroke.
      // Astro drops an attribute whose value is the empty string, so a row with no
      // flags has no data-flags at all — hence the ?? '' guards.
      const data = rows.map((r) => ({
        row: r,
        s: r.dataset.s ?? '',
        cats: (r.dataset.cat ?? '').split(' '),
        flags: (r.dataset.flags ?? '').split(' '),
        v: r.dataset.v === '1',
      }));
      const hit = (d, terms, c, fl, v) =>
        terms.every((t) => d.s.includes(t)) &&
        (!c || d.cats.includes(c)) &&
        fl.every((f) => d.flags.includes(f)) &&
        (!v || d.v);

      const apply = () => {
        const terms = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
        const activeFlags = [...flags];
        let shown = 0;
        for (const d of data) {
          const ok = hit(d, terms, cat, activeFlags, verified);
          d.row.hidden = !ok;
          if (ok) shown++;
        }
        count.textContent = `${shown} binar${shown === 1 ? 'y' : 'ies'}`;
        empty.hidden = shown > 0;
        // every chip's number is what the result count would be with that chip on,
        // so a count never contradicts what clicking it produces
        const tally = (c, fl, v) => data.reduce((n, d) => n + (hit(d, terms, c, fl, v) ? 1 : 0), 0);
        const setCount = (b, n) => {
          const s = b.querySelector('span');
          if (s) s.textContent = n;
          b.toggleAttribute('data-empty', n === 0);
        };
        catButtons.forEach((b) => setCount(b, tally(b.dataset.cat, activeFlags, verified)));
        flagButtons.forEach((b) =>
          setCount(b, tally(cat, flags.has(b.dataset.flag) ? activeFlags : [...activeFlags, b.dataset.flag], verified)),
        );
        setCount(verifiedButton, tally(cat, activeFlags, true));
        // every filter lives in the URL, so a filtered view can be shared
        const url = new URL(location.href);
        const set = (k, v) => (v ? url.searchParams.set(k, v) : url.searchParams.delete(k));
        set('q', q.value);
        set('cat', cat);
        set('flags', [...flags].join(','));
        set('verified', verified ? '1' : '');
        history.replaceState(null, '', url);
      };

      const catButtons = document.querySelectorAll('button[data-cat]');
      const flagButtons = document.querySelectorAll('button[data-flag]');
      const verifiedButton = document.querySelector('button[data-verified]');
      const setCat = (c) => {
        cat = c;
        catButtons.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.cat === c)));
      };
      catButtons.forEach((b) => b.addEventListener('click', () => { setCat(b.dataset.cat); apply(); }));
      flagButtons.forEach((b) => b.addEventListener('click', () => {
        const on = b.getAttribute('aria-pressed') !== 'true';
        b.setAttribute('aria-pressed', String(on));
        on ? flags.add(b.dataset.flag) : flags.delete(b.dataset.flag);
        apply();
      }));
      verifiedButton.addEventListener('click', () => {
        verified = !verified;
        verifiedButton.setAttribute('aria-pressed', String(verified));
        apply();
      });
      q.addEventListener('input', apply);

      const params = new URLSearchParams(location.search);
      q.value = params.get('q') ?? '';
      const initialCat = params.get('cat') ?? '';
      if ([...catButtons].some((b) => b.dataset.cat === initialCat)) setCat(initialCat);
      for (const f of (params.get('flags') ?? '').split(',')) {
        const b = [...flagButtons].find((x) => x.dataset.flag === f);
        if (b) { flags.add(f); b.setAttribute('aria-pressed', 'true'); }
      }
      if (params.get('verified') === '1') { verified = true; verifiedButton.setAttribute('aria-pressed', 'true'); }
      apply(); // unconditional: the chip counts are computed here, not rendered static
      // no autofocus on touch screens: it pops the keyboard over the table
      if (matchMedia('(pointer: fine)').matches) q.focus();
    })();
  </script>
</Base>
