{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofndb/schema/targets.schema.json",
  "title": "Target binary names (data/targets.json)",
  "description": "Names gathered from LOLBAS, LOLRMM, Sysinternals and SigmaHQ. Keys are lowercase file names: no leading dot or whitespace (Sigma endswith fragments like '.pdf.exe' are not binaries), no path separators.",
  "type": "object",
  "required": ["updated", "counts", "targets"],
  "properties": {
    "updated": { "type": "string", "format": "date" },
    "sigma_release": { "type": "string" },
    "counts": {
      "type": "object",
      "required": ["targets"],
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "targets": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "required": ["sources"],
        "additionalProperties": false,
        "properties": {
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["lolbas", "lolrmm", "sysinternals", "sigma", "curated"] }
          },
          "lolbas": {
            "type": "object",
            "required": ["url", "category"],
            "properties": {
              "url": { "type": "string", "format": "uri", "pattern": "^https://" },
              "category": { "type": "string" },
              "paths": { "type": "array", "items": { "type": "string" } }
            }
          },
          "lolrmm": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["tool", "claimed_original_filename"],
              "properties": {
                "tool": { "type": "string", "minLength": 1 },
                "claimed_original_filename": { "type": ["string", "null"] }
              }
            }
          },
          "sigma_rule_refs": { "type": "integer", "minimum": 0 },
          "is_pe": { "type": "boolean" },
          "in_winbindex": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[^\\s.A-Z\\\\/]([^A-Z\\\\/]*[^\\sA-Z\\\\/])?$" }
  }
}
