{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ofndb/schema/sysmon-validation.schema.json",
  "title": "Sysmon ground truth (data/validation/sysmon.json)",
  "description": "One row per launch of an exact build (by SHA256) under Sysmon: what Sysmon logged and what the PE parses to.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "sha256", "parsed", "match", "sysmon_version", "os_build", "verified"],
    "properties": {
      "name": { "type": "string", "pattern": "^[^A-Z]+$" },
      "mode": { "enum": ["run", "suspended", "image_load"] },
      "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "sysmon_original_filename": { "type": ["string", "null"] },
      "parsed_original_filename": { "type": ["string", "null"] },
      "parsed": { "type": "boolean" },
      "match": { "type": "boolean" },
      "sysmon_version": { "type": "string" },
      "os_build": { "type": "string" },
      "verified": { "type": "string", "format": "date" }
    }
  }
}
